<!-- Mixture of TACOT and air species -->
<!-- Species: phenolic decomposition products + air + solid graphite char  -->
<!--                                                                       -->
<!-- Extended list: the 24 first species are those of the reference TACOT   -->
<!-- 3.0 B' table, plus CH CH2 CH3 C2H4 C2H6 C3H3 C6H5O C6H5OH O2 OH.       -->
<!-- (HNC, the 25th reference species, is only in tacot-air_25.xml.)        -->
<!--                                                                       -->
<!-- Pyrolysis gas elemental composition from the TACOT 3.0 workbook,       -->
<!-- 'Pyrolysis model' sheet (Sykes, NASA TN D-3810, 1967):                 -->
<!--   C:0.206, H:0.679, O:0.115  (mole fractions)                          -->
<!-- equivalent to the molar mixture of the 'Pyrolysis-gas chemistry' sheet:-->
<!--   H2:0.4992, H2O:0.2336, CH4:0.1000, C6H5OH:0.0891,                    -->
<!--   CO:0.0576, CO2:0.0157, C6H6:0.0048                                   -->
<mixture thermo_db="NASA-9" >

    <species>
       C H O N CH4 CN CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5 HCN
       H2 H2O N2 CH2OH CNN CNC CNCOCN C6H6 CH CH2 CH3 C2H4 C2H6 C3H3,1-propynl
       C3H3,2-propynl C6H5O,phenoxy C6H5OH,phenol O2 OH C(gr)
    </species>

    <element_compositions default="air">
        <composition name="air">N:0.79, O:0.21</composition>
        <composition name="tacot_pyro">C:0.206, H:0.679, O:0.115</composition>
        <composition name="tacot_char">C:1.0</composition>
    </element_compositions>

</mixture>
