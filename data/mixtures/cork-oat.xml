<!-- ===================================================================== -->
<!-- Liège / phénolique (cork P50) en ablation sous flamme oxyacétylénique -->
<!-- (sortie de torche OAT, type ASTM E285).                               -->
<!--                                                                       -->
<!-- Même matériau, même gaz de pyrolyse, même char et même liste          -->
<!-- d'espèces que data/mixtures/cork-air.xml : SEULE la composition de    -->
<!-- bord de couche limite change.                                         -->
<!--                                                                       -->
<!-- Bord de couche limite = produits de C2H2 + r O2 (r = rapport          -->
<!-- volumique O2/C2H2 de la torche), SANS entraînement d'air ambiant      -->
<!-- (sortie de buse). Fractions MOLAIRES élémentaires, C:H:O = 2:2:2r :   -->
<!--                                                                       -->
<!--   r = 1.0  flamme neutre            C:0.3333, H:0.3333, O:0.3333      -->
<!--   r = 1.3  réglage OAT usuel        C:0.3030, H:0.3030, O:0.3939      -->
<!--   r = 2.5  stoechiométrique (CO2)   C:0.2222, H:0.2222, O:0.5556      -->
<!--                                                                       -->
<!-- Flamme + air entraîné : fraction MASSIQUE f d'air ambiant mélangée   -->
<!-- aux produits de flamme (N2/O2 = 79/21) avant d'atteindre la paroi :   -->
<!--                                                                       -->
<!--   r = 1.0, f = 0.25   C:0.2724, H:0.2724, O:0.3108, N:0.1443          -->
<!--   r = 1.0, f = 0.50   C:0.1995, H:0.1995, O:0.2838, N:0.3171          -->
<!--   r = 1.3, f = 0.25   C:0.2450, H:0.2450, O:0.3587, N:0.1513          -->
<!--   r = 1.3, f = 0.50   C:0.1772, H:0.1772, O:0.3175, N:0.3281          -->
<!--                                                                       -->
<!-- Sans entraînement (f = 0), l'azote est absent du bord : les espèces  -->
<!-- azotées de la liste restent à fraction nulle (liste conservée pour    -->
<!-- comparer terme à terme à la table air).                               -->
<!-- Voir cork_bprime/cork_bprime_oat.py.                                  -->
<!-- ===================================================================== -->
<mixture thermo_db="NASA-9">

    <species>
       C H O N CH4 CN CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5
       HCN H2 H2O N2 CH2OH CNN CNC CNCOCN C6H6 HNC C(gr)
    </species>

    <element_compositions default="oat_r1p3">
        <composition name="oat_r1p0">C:0.333333, H:0.333333, O:0.333334</composition>
        <composition name="oat_r1p3">C:0.303030, H:0.303030, O:0.393940</composition>
        <composition name="oat_r2p5">C:0.222222, H:0.222222, O:0.555556</composition>
        <composition name="oat_r1p0_air25">C:0.272440, H:0.272440, O:0.310803, N:0.144317</composition>
        <composition name="oat_r1p0_air50">C:0.199537, H:0.199537, O:0.283829, N:0.317097</composition>
        <composition name="oat_r1p3_air25">C:0.245011, H:0.245011, O:0.358722, N:0.151255</composition>
        <composition name="oat_r1p3_air50">C:0.177169, H:0.177169, O:0.317542, N:0.328120</composition>
        <composition name="air">N:0.79, O:0.21</composition>
        <composition name="cork_pyro">C:0.287, H:0.592, O:0.121</composition>
        <composition name="cork_char">C:1.0</composition>
    </element_compositions>

</mixture>
