<!-- ===================================================================== -->
<!-- Gaz de pyrolyse seul du liège/phénolique, à l'équilibre chimique.     -->
<!--                                                                       -->
<!-- Sert à calculer les propriétés du gaz de pyrolyse (h_g, Cp, M, gamma, -->
<!-- rho, mu) en fonction de T et P, avec l'outil `mppequil`. h_g est la    -->
<!-- grandeur qui manque à la table B' pour fermer le bilan d'énergie de   -->
<!-- surface (avec h_w) et le terme source de pyrolyse en profondeur       -->
<!-- (h_g - h_s).                                                          -->
<!--                                                                       -->
<!-- À NE PAS confondre avec cork-air.xml : ici il n'y a NI air NI char —  -->
<!-- c'est le gaz de pyrolyse pur, avant qu'il n'atteigne la paroi. Sa     -->
<!-- composition élémentaire est celle du mélange des gaz du liège et de   -->
<!-- la résine (80/20 masse, rendements 25 % et 50 %).                     -->
<!--                                                                       -->
<!-- PAS DE PHASE CONDENSÉE : ajouter C(gr) ferait précipiter du carbone   -->
<!-- solide et changerait h_g. C'est la convention retenue pour les tables -->
<!-- de propriétés du gaz de pyrolyse (cf. classeur TACOT 3.0, feuille     -->
<!-- 'Pyrolysis model'). Elle mérite d'être vérifiée ici : ce gaz est plus -->
<!-- riche en carbone que celui d'un carbone/phénolique (C:0.240 contre    -->
<!-- C:0.206), donc plus proche de la limite de dépôt de suie.             -->
<!--                                                                       -->
<!-- Espèces : liste de cork-air.xml privée de C(gr), plus les espèces     -->
<!-- azotées retirées (pas d'azote dans le gaz de pyrolyse).               -->
<!-- ===================================================================== -->
<mixture thermo_db="NASA-9">

    <species>
       C H O CH4 CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5
       H2 H2O CH2OH C6H6
    </species>

    <element_compositions default="cork_pyro">
        <composition name="cork_pyro">C:0.240, H:0.631, O:0.129</composition>
    </element_compositions>

</mixture>
