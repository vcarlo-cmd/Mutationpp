<!-- ===================================================================== -->
<!-- CPh70 — composite carbone/phénolique dense                            -->
<!--   fibres de carbone : 70 % du volume solide                           -->
<!--   résine phénolique : 30 % du volume solide                           -->
<!--   porosité          : 0.01                                            -->
<!--                                                                       -->
<!-- Fibres et résine identiques à celles du TACOT (fibres ex-cellulose     -->
<!-- 1600 kg/m3, novolac/formaldéhyde 1200 kg/m3) : seules les proportions  -->
<!-- et la porosité changent.                                              -->
<!-- ===================================================================== -->
<!--                                                                       -->
<!-- IMPORTANT — pourquoi ce fichier est identique à tacot-air_25.xml :     -->
<!--                                                                       -->
<!-- La table B' est une condition limite de thermochimie de surface. Le    -->
<!-- solveur (Thermodynamics::surfaceMassBalance) ne prend que trois        -->
<!-- compositions ELEMENTAIRES — bord de couche limite, gaz de pyrolyse,    -->
<!-- char — plus T, P et B'g. Ni la densité, ni la porosité, ni le rapport  -->
<!-- fibres/résine n'entrent dans ce bilan.                                 -->
<!--                                                                       -->
<!--   - gaz de pyrolyse : produit par la résine seule. Résine inchangée    -->
<!--     => composition élémentaire inchangée (seule la QUANTITE change).   -->
<!--   - char : fibres de carbone et résine carbonisée sont toutes deux du  -->
<!--     carbone pur => C:1.0 quel que soit le rapport fibres/résine.       -->
<!--                                                                       -->
<!-- La table B'c(T,P,B'g) et h_w(T,P,B'g) sont donc RIGOUREUSEMENT les     -->
<!-- mêmes que pour le TACOT. Ce qui change est la réponse matériau :       -->
<!-- densités, rendement en char, et surtout le couplage B'g = k . B'c      -->
<!-- en ablation stationnaire, avec k = (rho_v - rho_c)/rho_c :             -->
<!--                                                                       -->
<!--        TACOT (10/10/80) : rho_v =  280   rho_c =  220   k = 0.2727     -->
<!--        CPh70 (69/30/1)  : rho_v = 1465.2 rho_c = 1287.0 k = 0.1385     -->
<!--                                                                       -->
<!-- Voir tacot_bprime/material_response.py pour le calcul et le tracé de   -->
<!-- la ligne de fonctionnement.                                            -->
<!--                                                                       -->
<!-- Ce fichier n'est donc justifié que par la traçabilité (nommer le       -->
<!-- matériau). Si en revanche la RESINE ou la NATURE DES FIBRES changent   -->
<!-- (autre polymère, fibres de silice...), alors tacot_pyro et/ou          -->
<!-- tacot_char doivent être recalculés et la table B' est différente.      -->
<!-- ===================================================================== -->
<mixture thermo_db="NASA-9" >

    <species>
       C H O N CH4 CN CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5
       HCN H2 H2O N2 CH2OH CNN CNC CNCOCN C6H6 HNC C(gr)
    </species>

    <element_compositions default="air">
        <composition name="air">N:0.79, O:0.21</composition>
        <composition name="cph70_pyro">C:0.206, H:0.679, O:0.115</composition>
        <composition name="cph70_char">C:1.0</composition>
    </element_compositions>

</mixture>
