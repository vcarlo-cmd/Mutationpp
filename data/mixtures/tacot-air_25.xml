<!-- TACOT (Theoretical Ablative Composite for Open Testing) ablation in air -->
<!--                                                                        -->
<!-- Species list reproduces EXACTLY the 25 gas species of the reference     -->
<!-- B' table distributed with the TACOT 3.0 workbook ('B' table' sheet),    -->
<!-- itself obtained by reduction of a 112-species CEA list.                 -->
<!--                                                                        -->
<!-- C(gr) is added as the condensed char phase: it is not part of the       -->
<!-- reference *gas* species list, but the multiphase equilibrium solver     -->
<!-- needs it so that the excess char carbon can condense (otherwise         -->
<!-- Y_w,C -> 1 and B'c saturates at its non-physical cap).                  -->
<!--                                                                        -->
<!-- Pyrolysis gas elemental composition from the 'Pyrolysis model' sheet    -->
<!-- (Sykes, NASA TN D-3810, 1967):  C:0.206, H:0.679, O:0.115              -->
<mixture thermo_db="NASA-9" >

    <species>
       C H O N CH4 CN CO CO2 C2 C2H C2H2,acetylene C3 C4 C4H2,butadiyne C5
       HCN H2 H2O N2 CH2OH CNN CNC CNCOCN C6H6 HNC C(gr)
    </species>

    <element_compositions default="air">
        <composition name="air">N:0.79, O:0.21</composition>
        <composition name="tacot_pyro">C:0.206, H:0.679, O:0.115</composition>
        <composition name="tacot_char">C:1.0</composition>
    </element_compositions>

</mixture>
